{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/session-start.mjs\"",
            "timeout": 5,
            "statusMessage": "Загрузка профиля выбранного проекта 1С"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/guard.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking the selected 1C project source boundary"
          }
        ]
      }
    ]
  }
}
