{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "1C AI Core deterministic policy registry",
  "type": "object",
  "required": [
    "registrySchemaVersion",
    "registryVersion",
    "selectorSyntax",
    "oneC",
    "yaxunit"
  ],
  "additionalProperties": false,
  "properties": {
    "registrySchemaVersion": {
      "const": 2
    },
    "registryVersion": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[0-9]+$"
    },
    "selectorSyntax": {
      "const": "document-id#exact-heading"
    },
    "oneC": {
      "$ref": "#/$defs/oneC"
    },
    "yaxunit": {
      "$ref": "#/$defs/yaxunit"
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "rule": {
      "type": "object",
      "required": [
        "id",
        "strength",
        "selectors"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "strength": {
          "enum": [
            "mandatory",
            "recommended"
          ]
        },
        "artifacts": {
          "$ref": "#/$defs/stringList"
        },
        "operations": {
          "$ref": "#/$defs/stringList"
        },
        "any": {
          "$ref": "#/$defs/stringList"
        },
        "covers": {
          "$ref": "#/$defs/stringList"
        },
        "selectors": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "oneC": {
      "type": "object",
      "required": [
        "artifacts",
        "operations",
        "mechanisms",
        "rules"
      ],
      "additionalProperties": false,
      "properties": {
        "artifacts": {
          "$ref": "#/$defs/stringList"
        },
        "operations": {
          "$ref": "#/$defs/stringList"
        },
        "mechanisms": {
          "$ref": "#/$defs/stringList"
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          },
          "minItems": 1
        }
      }
    },
    "yaxunit": {
      "type": "object",
      "required": [
        "operations",
        "authoringOperations",
        "mechanisms",
        "rules"
      ],
      "additionalProperties": false,
      "properties": {
        "operations": {
          "$ref": "#/$defs/stringList"
        },
        "authoringOperations": {
          "$ref": "#/$defs/stringList"
        },
        "mechanisms": {
          "$ref": "#/$defs/stringList"
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          },
          "minItems": 1
        }
      }
    }
  }
}
