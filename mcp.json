{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "openviking": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/mcp/openviking.mjs"
      ],
      "env_vars": [
        "OPENVIKING_SEARCH_TOKEN",
        "EDT_AI_OPENVIKING_ACCESS_BINDING_KEY",
        "EDT_AI_OPENVIKING_ACCESS_PUBLIC_KEY",
        "EDT_AI_OPENVIKING_ACCESS_RECEIPTS",
        "EDT_AI_OPENVIKING_PUBLICATION_PUBLIC_KEY",
        "EDT_AI_OPENVIKING_PUBLICATION_RECEIPTS"
      ]
    },
    "policy": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/policy/read-only-mcp.mjs"
      ]
    },
    "1c-ai-settings": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/mcp/settings.mjs"
      ],
      "env_vars": [
        "OPENVIKING_SEARCH_TOKEN",
        "EDT_AI_OPENVIKING_ACCESS_BINDING_KEY",
        "EDT_AI_OPENVIKING_ACCESS_PUBLIC_KEY",
        "EDT_AI_OPENVIKING_ACCESS_RECEIPTS",
        "EDT_AI_OPENVIKING_PUBLICATION_PUBLIC_KEY",
        "EDT_AI_OPENVIKING_PUBLICATION_RECEIPTS"
      ]
    },
    "code-index": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/scripts/lazy_mcp.mjs",
        "--component",
        "code-index"
      ],
      "env_vars": [
        "OPENVIKING_SEARCH_TOKEN",
        "EDT_AI_OPENVIKING_ACCESS_BINDING_KEY",
        "EDT_AI_OPENVIKING_ACCESS_PUBLIC_KEY",
        "EDT_AI_OPENVIKING_ACCESS_RECEIPTS",
        "EDT_AI_OPENVIKING_PUBLICATION_PUBLIC_KEY",
        "EDT_AI_OPENVIKING_PUBLICATION_RECEIPTS"
      ]
    },
    "bsl-ls": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/scripts/lazy_mcp.mjs",
        "--component",
        "bsl-ls"
      ],
      "env_vars": [
        "OPENVIKING_SEARCH_TOKEN",
        "EDT_AI_OPENVIKING_ACCESS_BINDING_KEY",
        "EDT_AI_OPENVIKING_ACCESS_PUBLIC_KEY",
        "EDT_AI_OPENVIKING_ACCESS_RECEIPTS",
        "EDT_AI_OPENVIKING_PUBLICATION_PUBLIC_KEY",
        "EDT_AI_OPENVIKING_PUBLICATION_RECEIPTS"
      ]
    },
    "edt": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/scripts/lazy_mcp.mjs",
        "--component",
        "edt"
      ],
      "env_vars": [
        "OPENVIKING_SEARCH_TOKEN",
        "EDT_AI_OPENVIKING_ACCESS_BINDING_KEY",
        "EDT_AI_OPENVIKING_ACCESS_PUBLIC_KEY",
        "EDT_AI_OPENVIKING_ACCESS_RECEIPTS",
        "EDT_AI_OPENVIKING_PUBLICATION_PUBLIC_KEY",
        "EDT_AI_OPENVIKING_PUBLICATION_RECEIPTS"
      ]
    },
    "v8std": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/scripts/lazy_mcp.mjs",
        "--component",
        "v8std"
      ],
      "env_vars": [
        "OPENVIKING_SEARCH_TOKEN",
        "EDT_AI_OPENVIKING_ACCESS_BINDING_KEY",
        "EDT_AI_OPENVIKING_ACCESS_PUBLIC_KEY",
        "EDT_AI_OPENVIKING_ACCESS_RECEIPTS",
        "EDT_AI_OPENVIKING_PUBLICATION_PUBLIC_KEY",
        "EDT_AI_OPENVIKING_PUBLICATION_RECEIPTS"
      ]
    }
  }
}
