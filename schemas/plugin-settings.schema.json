{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "state_dir",
    "active_project",
    "mcp"
  ],
  "properties": {
    "version": {
      "const": "0.1.0"
    },
    "state_dir": {
      "type": "string",
      "minLength": 1
    },
    "active_project": {
      "type": [
        "string",
        "null"
      ]
    },
    "mcp": {
      "type": "object",
      "required": [
        "required",
        "managed",
        "optional"
      ],
      "properties": {
        "required": {
          "type": "object",
          "required": [
            "edt",
            "v8std"
          ],
          "properties": {
            "edt": {
              "type": "object",
              "required": [
                "mode",
                "url"
              ],
              "properties": {
                "mode": {
                  "const": "user"
                },
                "url": {
                  "type": "string",
                  "pattern": "^(?:https?://[^\\s]+)?$"
                },
                "enabled": {
                  "type": "boolean"
                },
                "timeout_seconds": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "max_response_bytes": {
                  "type": "integer",
                  "minimum": 1024
                },
                "headers_env": {
                  "type": "object",
                  "propertyNames": {
                    "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
                  },
                  "additionalProperties": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                  }
                }
              },
              "additionalProperties": false
            },
            "v8std": {
              "type": "object",
              "required": [
                "mode",
                "url"
              ],
              "properties": {
                "mode": {
                  "const": "user"
                },
                "url": {
                  "type": "string",
                  "pattern": "^(?:https?://[^\\s]+)?$"
                },
                "enabled": {
                  "type": "boolean"
                },
                "timeout_seconds": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "max_response_bytes": {
                  "type": "integer",
                  "minimum": 1024
                },
                "headers_env": {
                  "type": "object",
                  "propertyNames": {
                    "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
                  },
                  "additionalProperties": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "managed": {
          "type": "object",
          "required": [
            "code-index",
            "bsl-ls"
          ],
          "properties": {
            "code-index": {
              "type": "object",
              "required": [
                "mode",
                "version"
              ],
              "properties": {
                "mode": {
                  "enum": [
                    "auto",
                    "external"
                  ]
                },
                "version": {
                  "type": "string",
                  "pattern": "^(latest|[A-Za-z0-9][A-Za-z0-9._+-]{0,127})$"
                },
                "allow_prerelease": {
                  "type": "boolean",
                  "default": false
                },
                "enabled": {
                  "type": "boolean"
                },
                "timeout_seconds": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "max_response_bytes": {
                  "type": "integer",
                  "minimum": 1024
                },
                "headers_env": {
                  "type": "object",
                  "propertyNames": {
                    "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
                  },
                  "additionalProperties": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                  }
                },
                "url": {
                  "type": "string",
                  "pattern": "^(?:https?://[^\\s]+)?$"
                }
              },
              "additionalProperties": false
            },
            "bsl-ls": {
              "type": "object",
              "required": [
                "mode",
                "version"
              ],
              "properties": {
                "mode": {
                  "enum": [
                    "auto",
                    "external"
                  ]
                },
                "version": {
                  "type": "string",
                  "pattern": "^(latest|[A-Za-z0-9][A-Za-z0-9._+-]{0,127})$"
                },
                "allow_prerelease": {
                  "type": "boolean",
                  "default": false
                },
                "java": {
                  "type": "string",
                  "minLength": 1
                },
                "node": {
                  "type": "string",
                  "minLength": 1
                },
                "configuration": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                },
                "enabled": {
                  "type": "boolean"
                },
                "timeout_seconds": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "max_response_bytes": {
                  "type": "integer",
                  "minimum": 1024
                },
                "headers_env": {
                  "type": "object",
                  "propertyNames": {
                    "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
                  },
                  "additionalProperties": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                  }
                },
                "url": {
                  "type": "string",
                  "pattern": "^(?:https?://[^\\s]+)?$"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "optional": {
          "type": "object",
          "properties": {
            "openviking": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "url": {
                  "type": "string",
                  "pattern": "^(?:https?://[^\\s]+)?$"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
