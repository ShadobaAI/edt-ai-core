{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider", "server", "collections", "publication_revision", "manifest_sha256", "index_revision", "verified_at", "expires_at", "evidence_ref"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "provider": { "const": "openviking" },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint", "scope"],
      "properties": {
        "endpoint": { "type": "string", "pattern": "^https?://[^\\s]+$" },
        "scope": { "$ref": "#/$defs/text" }
      }
    },
    "collections": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" }
    },
    "publication_revision": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
    "manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "index_revision": { "$ref": "#/$defs/text" },
    "verified_at": { "$ref": "#/$defs/instant" },
    "expires_at": { "$ref": "#/$defs/instant" },
    "evidence_ref": { "$ref": "#/$defs/text" }
  },
  "$defs": {
    "text": { "type": "string", "pattern": "\\S" },
    "instant": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$" }
  }
}
