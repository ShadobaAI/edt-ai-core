{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider", "server", "collections", "publication_revision", "manifest_sha256", "index_revision", "collection_snapshots", "verification", "verified_at", "expires_at", "evidence_ref"],
  "properties": {
    "schema_version": { "const": "0.2" },
    "provider": { "const": "openviking" },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint", "scope"],
      "properties": {
        "endpoint": { "type": "string", "pattern": "^https?://[^\\s]+$" },
        "scope": { "$ref": "#/$defs/text" }
      }
    },
    "collections": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" }
    },
    "publication_revision": { "description": "External publisher's resolved Git commit; never the plugin version or a self-reference inside the committed manifest.", "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
    "manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "index_revision": { "$ref": "#/$defs/text" },
    "collection_snapshots": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["collection", "root", "material_count", "materials_sha256"],
        "properties": {
          "collection": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
          "root": { "type": "string", "pattern": "^viking://resources/[\\p{L}\\p{N}._/-]+$", "maxLength": 2048 },
          "material_count": { "type": "integer", "minimum": 0 },
          "materials_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["git_manifest", "index_contents", "excluded_materials", "deleted_materials", "changed_materials", "delivery", "deployment_id"],
      "properties": {
        "git_manifest": { "const": "matched_committed_bytes" },
        "index_contents": { "const": "exact_active_manifest" },
        "excluded_materials": { "const": "absent" },
        "deleted_materials": { "const": "absent" },
        "changed_materials": { "const": "matched" },
        "delivery": { "const": "immutable_endpoint" },
        "deployment_id": { "$ref": "#/$defs/text" }
      }
    },
    "verified_at": { "$ref": "#/$defs/instant" },
    "expires_at": { "$ref": "#/$defs/instant" },
    "evidence_ref": { "$ref": "#/$defs/text" }
  },
  "$defs": {
    "text": { "type": "string", "pattern": "\\S" },
    "instant": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$" }
  }
}
