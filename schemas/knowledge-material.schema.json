{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "title", "provenance", "scope", "revision", "compatibility", "status"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "kind": { "enum": ["document", "api_card"] },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "title": { "$ref": "#/$defs/text" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" }
      }
    },
    "scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
    "revision": { "$ref": "#/$defs/text" },
    "compatibility": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,63}$" },
      "additionalProperties": { "$ref": "#/$defs/text" }
    },
    "status": { "enum": ["draft", "published", "confirmed", "review_required", "obsolete"] },
    "intent": { "$ref": "#/$defs/text_list" },
    "recommended_api": { "$ref": "#/$defs/text" },
    "recommendation": { "enum": ["use", "avoid"] },
    "when_to_use": { "$ref": "#/$defs/text_list" },
    "when_not_to_use": { "$ref": "#/$defs/text_list" },
    "contract": { "$ref": "#/$defs/text" },
    "context": { "$ref": "#/$defs/text_list" },
    "verification_ref": { "$ref": "#/$defs/text" },
    "verified_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "avoid_reason": { "$ref": "#/$defs/text" }
  },
  "allOf": [{
    "if": { "properties": { "kind": { "const": "api_card" } } },
    "then": {
      "required": ["intent", "recommended_api", "recommendation", "when_to_use", "when_not_to_use", "contract", "context", "verification_ref", "verified_at"],
      "properties": { "status": { "enum": ["confirmed", "review_required", "obsolete"] } },
      "allOf": [{
        "if": { "properties": { "recommendation": { "const": "avoid" } } },
        "then": { "required": ["avoid_reason"] }
      }]
    },
    "else": {
      "properties": {
        "status": { "enum": ["draft", "published", "obsolete"] },
        "intent": false, "recommended_api": false, "recommendation": false,
        "when_to_use": false, "when_not_to_use": false, "contract": false,
        "context": false, "verification_ref": false, "verified_at": false, "avoid_reason": false
      }
    }
  }],
  "$defs": {
    "text": { "type": "string", "pattern": "\\S" },
    "text_list": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } }
  }
}
